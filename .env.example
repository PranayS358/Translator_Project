# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Database (Neon Postgres connection string) ──────────────────────────────
# From neon.tech dashboard -> your project -> Connection Details
# Looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# The actual WhatsApp number customers message, digits only with country code
# (e.g. 917719956774) - used to build wa.me links for the "Continue on
# WhatsApp" button in the website chat widget. Leave blank to disable that button.
WHATSAPP_BUSINESS_DISPLAY_NUMBER=

# ── Facebook Messenger (optional - leave blank to skip this channel) ───────
PAGE_ACCESS_TOKEN=

# ── Instagram Messaging (optional - leave blank to skip this channel) ──────
# Often the same as PAGE_ACCESS_TOKEN if your IG account is linked to the Page
IG_PAGE_ACCESS_TOKEN=

# ── Shared webhook verify token (same value entered in Meta's dashboard,
# used for WhatsApp, Messenger, and Instagram webhook setup) ────────────────
WEBHOOK_VERIFY_TOKEN=demo_verify_token

# ── App Secret (Meta App Settings -> Basic -> App Secret) ──────────────────
# Enables webhook signature verification. Leave blank to skip verification
# during early local testing, but set this before deploying anywhere public.
META_APP_SECRET=

# ── API key protecting /api/* routes from strangers on the internet ────────
# Leave as change_me to disable the check during local dev; set a real
# random string before deploying publicly.
API_KEY=change_me

# ── MyMemory Translation (free, no signup) ──────────────────────────────────
# Optional: add your email to raise the free daily limit from 5,000 to
# 50,000 characters. Leave blank to use the anonymous 5,000/day limit.
MYMEMORY_EMAIL=

# ── Google Cloud Translation API (optional but recommended) ────────────────
# Used as the primary translation engine when set - much higher quality than
# MyMemory across every language, and the only one of the two that can
# actually handle Hinglish (Hindi written in Latin script). Falls back to
# MyMemory automatically if this is left blank or a call to Google fails.
# Get a key: console.cloud.google.com -> enable "Cloud Translation API" ->
# APIs & Services -> Credentials -> Create API Key. Free tier covers ~500K
# characters/month; requires billing enabled on the Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

# ── Behavior ─────────────────────────────────────────────────────────────
AUTO_REPLY=true
