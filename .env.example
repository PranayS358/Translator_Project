# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Database (Supabase Postgres connection strings) ──────────────────────────
# From supabase.com dashboard -> project -> Connect -> ORM -> Prisma.
# DATABASE_URL: pooled (pgbouncer transaction-mode, port 6543) - used for all
# normal app queries at runtime.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: session-mode pooler (port 5432) - only used by `prisma migrate`,
# since the transaction-mode pooler above doesn't support the prepared
# statements the migration engine needs (see directUrl in prisma/schema.prisma).
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# The actual WhatsApp number customers message, digits only with country code
# (e.g. 917719956774) - used to build wa.me links for the "Continue on
# WhatsApp" button in the website chat widget. Leave blank to disable that button.
WHATSAPP_BUSINESS_DISPLAY_NUMBER=

# ── Facebook Messenger (optional - leave blank to skip this channel) ───────
PAGE_ACCESS_TOKEN=

# ── Instagram Messaging (optional - leave blank to skip this channel) ──────
# Often the same as PAGE_ACCESS_TOKEN if your IG account is linked to the Page
IG_PAGE_ACCESS_TOKEN=

# ── Shared webhook verify token (same value entered in Meta's dashboard,
# used for WhatsApp, Messenger, and Instagram webhook setup) ────────────────
WEBHOOK_VERIFY_TOKEN=demo_verify_token

# ── App Secret (Meta App Settings -> Basic -> App Secret) ──────────────────
# Enables webhook signature verification. Leave blank to skip verification
# during early local testing, but set this before deploying anywhere public.
META_APP_SECRET=

# ── API key protecting /api/* routes from strangers on the internet ────────
# Leave as change_me to disable the check during local dev; set a real
# random string before deploying publicly.
API_KEY=change_me

# ── MyMemory Translation (free, no signup) ──────────────────────────────────
# Optional: add your email to raise the free daily limit from 5,000 to
# 50,000 characters. Leave blank to use the anonymous 5,000/day limit.
MYMEMORY_EMAIL=

# ── Google Cloud Translation API (optional but recommended) ────────────────
# Used as the primary translation engine when set - much higher quality than
# MyMemory across every language, and the only one of the two that can
# actually handle Hinglish (Hindi written in Latin script). Falls back to
# MyMemory automatically if this is left blank or a call to Google fails.
# Get a key: console.cloud.google.com -> enable "Cloud Translation API" ->
# APIs & Services -> Credentials -> Create API Key. Free tier covers ~500K
# characters/month; requires billing enabled on the Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

# ── Groq API (free instant auto-reply bot for the HC website chat widget) ──
# Free API key, no credit card: console.groq.com/keys. Leave blank to
# disable the bot entirely — every message just waits for a human agent,
# exactly like before this feature existed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Plain-text facts the bot is allowed to answer from (hours, services,
# booking, location). Keep it to logistics — the bot is instructed to
# escalate to a human for anything medical, patient-specific, or not
# covered here. See DEFAULT_CLINIC_INFO in src/groq.js for the fallback
# used when this is left blank.
CLINIC_INFO="Wellness Care Clinic — Mon-Sat 9am-7pm, closed Sundays. Services: general checkups, family medicine, vaccinations, lab tests, dental care. Book an appointment right here in chat or by calling the front desk. See the Contact page for our address."
# Optional: override the demo doctor directory the booking flow uses (see
# DEFAULT_DOCTOR_ROSTER in src/groq.js for the shape/default). JSON, one
# array of doctors per department; each doctor is { name, popular, degree,
# experienceYears, fee } - degree/experienceYears/fee are optional (the bot
# just omits whatever's missing) but are what let it quote real credentials
# and cost (fee in INR) whenever it names a doctor. Mark one per department
# popular:true - that's who the bot recommends when a patient has no
# preference. Leave blank to use the built-in demo roster.
DOCTOR_ROSTER=
# Optional: override the demo diagnostic test catalog used by the "book a
# test" flow (see DEFAULT_TEST_CATALOG in src/groq.js for the shape/default) -
# for patients booking a standalone test (X-ray, blood work, etc.) rather
# than a doctor consultation. JSON, one array of tests per department; each
# test is { name, fee } (fee in INR). Leave blank to use the built-in demo
# catalog.
TEST_CATALOG=
# Emergency number the bot tells patients to call during the ambulance flow,
# as a backup alongside alerting your team - a chatbot reply has real
# latency and shouldn't be the only channel for an actual emergency.
# Defaults to 108 (India) if left blank - see EMERGENCY_NUMBER in src/groq.js.
EMERGENCY_NUMBER=108
# Optional: override the demo branch list used by the "nearest branch"
# finder (see DEFAULT_BRANCHES in src/groq.js). JSON array of
# { "name", "address", "lat", "lng" }. Leave blank to use the built-in demo
# branches (Bengaluru).
BRANCHES=

# ── Behavior ─────────────────────────────────────────────────────────────
AUTO_REPLY=true
