datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer transaction-mode) connection - used for all normal
  // app queries at runtime. Supabase's pooler doesn't support the prepared
  // statements Prisma's migration engine needs, so migrations run over
  // directUrl (the session-mode pooler) instead - see DIRECT_URL below.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// One Conversation per real-world contact, per channel. Both inbound and
// outbound messages attach to the SAME conversation - this is what fixes
// the "two separate inboxes" issue from v1.
model Conversation {
  id             String    @id @default(cuid())
  channel        String    // "whatsapp" | "messenger" | "instagram" | "webchat"
  contactKey     String    // normalized E.164 phone (WhatsApp), PSID/IGSID (Messenger/Instagram), or visitorId (webchat)
  displayName    String?
  favourite      Boolean   @default(false)
  muted          Boolean   @default(false)
  unreadCount    Int       @default(0)
  // Set when a webchat visitor links their own WhatsApp number to "continue this
  // chat there" - inbound WhatsApp messages from this number then merge into
  // THIS conversation instead of creating a separate whatsapp-channel one.
  linkedWhatsapp String?   @unique
  // Whether the Groq auto-reply bot is allowed to answer new inbound
  // messages on this conversation (see src/groq.js). Starts true; flipped to
  // false the moment a human agent sends a manual reply from the dashboard
  // (src/routes/api.js), so the bot never talks over a human who has taken
  // over. Can be flipped back on via PATCH /api/conversations/:id.
  botEnabled     Boolean   @default(true)
  // Auto-detected (via franc) from the visitor's first webchat message, or
  // explicitly set if they use the widget's "change language" button. Locked
  // in for the rest of the conversation so every message - both directions -
  // consistently uses the same language instead of re-detecting each time.
  customerLanguage String?
  // Set by the Groq bot (src/groq.js) the moment it detects an active
  // ambulance/emergency request, so agents can spot it immediately in the
  // dashboard sidebar instead of relying on the regular unread badge. Stays
  // true until an agent clears it via PATCH /api/conversations/:id.
  urgent         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  messages       Message[]

  @@unique([channel, contactKey])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  direction        String       // "inbound" | "outbound"
  originalText     String
  detectedLanguage String?
  translatedText   String?
  targetLanguage   String?
  // "text" | "image" | "video" | "document" | "audio" | "location" | "contact"
  messageType      String       @default("text")
  mediaUrl         String?      @db.Text // data URL for images/video/docs/audio previews
  fileName         String?
  extra            String?      // JSON string: location {lat,lng} or contact {name,phone}
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Settings {
  id              Int    @id @default(1)
  primaryLanguage String @default("en")
  theme           String @default("light") // "light" | "dark"
}
